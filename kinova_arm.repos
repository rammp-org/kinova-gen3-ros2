# kinova_arm.repos — colcon workspace source list.
# WARNING (2026-08-31): main is NOT enough to build this repo. Core PR #29 has
# merged, so main now has the streaming tier -- but this repo needs TWO further
# core PRs that are open SIBLINGS off main, so no single published PR branch is
# sufficient either:
#
#   #31 feat/stream-status-port  -- StreamSink::on_query_stream(); /stream_status
#                                   reports core's real session instead of ours
#   #32 feat/velocity-mode       -- JointVelocityMode + the EE-pose-into-position
#                                   path; Supervisor's ctor gains JointVelocityMode&
#   #33 feat/ee-twist-and-...    -- ArmState::ee_twist, for /ee_state
#
# A merge of the two is published for exactly this reason. Container builds need:
#     make build CORE_REF=integration/velocity-and-stream-status
#
# Once #31 and #32 both merge, drop the override and this note -- plain `main`
# works again, and that integration branch should be deleted.
# The rsync dev loop (scripts/abra_colcon.sh) is unaffected -- it copies the
# local core working tree, not this pin. Drop this note and keep `main` once
# #29 is merged.
#
# NOTE (2026-08): the CONTAINER build (docker/Dockerfile) does vcs-import this.
# The bare-metal dev loop does not — abra has no GitHub key, so scripts/abra_colcon.sh
# rsyncs a local core working tree in instead, which also picks up uncommitted
# core changes. Pinned to main now that Plan 2 (ports + Supervisor) is merged (PR #11).
repositories:
  kinova-gen3-driver:
    type: git
    # https, not ssh: docker/Dockerfile vcs-imports this with no key in the
    # image. The core repo is public, so an anonymous clone works.
    url: https://github.com/rammp-org/kinova-gen3-driver.git
    version: main
  RAMMP-CuRobo:
    type: git
    url: https://github.com/ChrissCox/RAMMP-CuRobo.git
    version: main
    # Only rammp_curobo_interfaces is a build dep (dependency-free IDL, no GPU stack).
    # The bare-metal loop rsyncs just that sub-package; container builds must scope
    # colcon with --packages-up-to kinova_arm_ros2 so the GPU packages are skipped.

# kinova_gen3.repos — colcon workspace source list.
#
# rammp-interfaces-ros2 is deliberately ABSENT. rammp_arm_interfaces and
# rammp_common_interfaces arrive compiled into rammp-base, so listing it here
# would build a second copy in /module_ws on top of the base's -- and a colcon
# workspace holds exactly one version of a package. The interface pin is the
# base image tag in the Dockerfile, not a line in this file. A native build
# clones rammp-interfaces-ros2 itself -- see the README's Build section.
#
# The versioning rules for the interfaces contract -- which changes are MAJOR, MINOR or
# PATCH, and the Cyclone DDS condition they depend on -- live in ONE place:
# the README of rammp-org/rammp-interfaces-ros2. They are deliberately not
# restated here; a rule copied into several repos gets flipped in one of them
# (this comment once said the opposite). One warning is worth repeating:
# inserting a field anywhere but the end of a message is a silent-corruption
# MAJOR change, not a minor one.
#
# BOTH repositories below are pinned to a TAG, never a branch. A tagged image
# that builds from a moving branch is not reproducible: rebuild v1.0.0 next
# month and you get whatever those branches have become, with nothing in this
# file changed to explain the difference.
#
# CORE_REF stays as a general escape hatch (see the Makefile) for the next time
# this repo needs a core change that has not reached a core release.
repositories:
  # The arm contract. Pinned to an EXACT TAG, never a branch: a colcon workspace
  # holds one version of a package, so this pin is what decides whether this
  # module can run alongside any other that speaks the same interfaces.
  kinova-gen3-driver:
    type: git
    # https, not ssh: docker/Dockerfile vcs-imports this with no key in the
    # image. The core repo is public, so an anonymous clone works.
    url: https://github.com/rammp-org/kinova-gen3-driver.git
    # BLOCKER (see CHANGELOG Unreleased): v1.1.1 has no TrajectoryGoal::speed_scale
    # or kMinSpeedScale, so this branch does not compile against it. Needs the
    # release cut from kinova-gen3-driver feature/69-trajectory-speed-scale; move
    # this pin when it exists. Verified only via a four-source workspace.
    version: v1.1.1
  RAMMP-CuRobo:
    type: git
    url: https://github.com/rammp-org/RAMMP-CuRobo.git
    # v1.0.0 and main carry an IDENTICAL IDL -- only rammp_curobo_interfaces'
    # package.xml <version> differs between them -- so this pin buys
    # reproducibility without changing the contract this module compiles against.
    # BLOCKER (see CHANGELOG Unreleased): v1.0.0's PlanToPose.action has no
    # hold/approach_via, so this branch does not compile against it. Needs
    # the release cut from RAMMP-CuRobo feature/16-pose-constraints-and-via-point;
    # move this pin when it exists. (The "identical IDL" note above no longer
    # holds for that release.) Also needs rammp-interfaces-ros2 1.2.0
    # (feature/38-lock-via-speed) in the rammp-base image -- see the Dockerfile.
    version: v1.0.0
    # Only rammp_curobo_interfaces is a build dep (dependency-free IDL, no GPU stack).
    # Builds must scope colcon with --packages-up-to kinova_gen3_ros2 so the GPU
    # packages are skipped.
